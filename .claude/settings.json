{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 900,
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 1; if [ -d node_modules/esbuild ] && [ -f node_modules/.package-lock.json ]; then echo \"node_modules already populated - skipping npm ci\"; else echo \"node_modules missing or incomplete - running npm ci\"; npm ci --no-audit --no-fund; fi; bash \"$CLAUDE_PROJECT_DIR/scripts/setup-agent-tools.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  }
}